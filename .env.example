# ==============================================================================
# PersonalOS Frontend Environment Variables (Configure in Vercel Dashboard)
# ==============================================================================

# Backend API Base URL (Render Web Service public HTTPS URL)
VITE_API_BASE_URL=https://your-personalos-backend.onrender.com

# Backend WebSocket URL (Render Web Service secure WebSocket endpoint)
# Optional: If omitted, tripSocket.js automatically derives this by replacing http/https with ws/wss in BASE_URL (from VITE_API_BASE_URL) and appending /ws (e.g., wss://your-personalos-backend.onrender.com/ws)
VITE_WS_URL=wss://your-personalos-backend.onrender.com/ws

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com


# ==============================================================================
# PersonalOS Backend Environment Variables (Configure in Render Dashboard)
# ==============================================================================

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Database Connection (Aiven MySQL 8 with SSL encryption)
DB_URL=jdbc:mysql://<aiven-host>:<aiven-port>/defaultdb?useSSL=true&requireSSL=true&verifyServerCertificate=false&serverTimezone=UTC
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_database_password
DB_POOL_SIZE=10

# Security - JWT Secret (Production secret must be generated securely with at least 32 random bytes / 256-bit entropy)
PERSONALOS_JWT_SECRET=your_production_jwt_secret_min_32_characters

# CORS - Frontend Production Origin (Vercel deployment URL without trailing slash)
PERSONALOS_FRONTEND_URL=https://your-personal-os.vercel.app

# Google OAuth Credentials
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Server Port (automatically set by Render)
PORT=8080
