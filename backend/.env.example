# PersonalOS Backend Production Environment Variables
# These variables should be configured in the Render Dashboard / Docker environment

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Database Connection (e.g., Aiven MySQL or Managed MySQL URI)
DB_URL=jdbc:mysql://<host>:<port>/<dbname>?useSSL=true&serverTimezone=UTC
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_POOL_SIZE=10

# Security - JWT Secret (Minimum 256-bit cryptographic random string)
PERSONALOS_JWT_SECRET=your_production_jwt_secret_min_32_characters

# CORS - Frontend Production Origin (Vercel deployment URL)
PERSONALOS_FRONTEND_URL=https://your-personal-os.vercel.app

# Google OAuth Credentials
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Server Port (automatically set by Render)
PORT=8080
