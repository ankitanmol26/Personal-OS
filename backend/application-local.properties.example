# PersonalOS Backend Local Configuration Example
# Copy to backend/application-local.properties for local development overrides (file is ignored by Git)

# Database Configuration
spring.datasource.url=jdbc:mysql://localhost:3306/personal_os?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=personalos
spring.datasource.password=your_db_password

# JWT Signing Secret (must be a strong, minimum 256-bit / 32-character secret)
personalos.jwt.secret=your_super_secret_jwt_signing_key_minimum_32_bytes_long

# Frontend Allowed Origin
personalos.frontend.url=http://localhost:5173

# Google OAuth Credentials (from Google Cloud Console)
google.oauth.client-id=your-google-client-id.apps.googleusercontent.com
google.oauth.client-secret=your-google-client-secret

# Migration / Bootstrap User (Optional in dev, default disabled in prod)
# personalos.migration.bootstrap-user.enabled=false
# PERSONALOS_BOOTSTRAP_PASSWORD=your_bootstrap_password

# Cookie Security Settings (false/Lax for local HTTP, true/None for HTTPS production)
personalos.cookies.secure=false
personalos.cookies.same-site=Lax
