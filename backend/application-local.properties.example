# Backend Local Environment Configuration Template
# Copy this file to application-local.properties in the backend directory.
# application-local.properties is ignored by git and stores your private credentials.

# MySQL database password (username defaults to personalos, URL defaults to personal_os database)
DB_PASSWORD=your_database_password

# JWT Signing Secret (must be a 256-bit+ secure random secret)
PERSONALOS_JWT_SECRET=your_jwt_signing_secret

# Google OAuth Web Client credentials (from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your_google_client_secret

# Frontend URL (defaults to http://localhost:5173)
PERSONALOS_FRONTEND_URL=http://localhost:5173
